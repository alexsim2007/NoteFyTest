@page
@model ThirdTry.Pages.Message
@{
    ViewData["Title"] = "Привет!";
}

<h1>@ViewData["Title"]</h1>

<div>
    <p>Введите свой классный текст внутрь окна:</p>
    
</div>
<div class="container">
    <h1>@ViewData["Title"]</h1>
    
    <div class="content">
        <p>Поле для ввода текста ниже:</p>
        
        <form method="post">
            <div class="form-group">
                <label>Введите текст:</label>
                <input type="text" class="form-control" name="userInput">
            </div>
            <button type="submit" class="btn btn-primary mt-3">Отправить</button>
        </form>
    </div>
</div>